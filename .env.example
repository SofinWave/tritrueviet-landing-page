APP_NAME=tri_tue_viet_landing
APP_PORT=3000

# Canonical site URL used for canonical links, hreflang, Open Graph, the
# sitemap, robots.txt and JSON-LD. Next.js inlines NEXT_PUBLIC_* vars into
# the prerendered output at BUILD TIME — changing this in a running
# container's runtime environment has no effect, it must be set before
# `pnpm build` / `docker build` runs. See docker-compose.production.yaml's
# `build.args`.
NEXT_PUBLIC_SITE_URL=https://tritueviet.example.com

# Match host user so bind-mounted files keep the right ownership (dev only)
# Get them with: id -u / id -g
UID_HOST_USER=1000
GID_HOST_USER=1000
